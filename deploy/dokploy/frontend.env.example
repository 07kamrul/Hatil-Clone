# Dokploy -> frontend app -> Environment. Read at runtime by src/server.ts and app.config.server.ts.
PUBLIC_BASE_URL=https://hatil.anshintech.dpdns.org
# SSR server -> API (origin only, /api/v1 is appended by the app)
API_INTERNAL_URL=https://hatilapi.anshintech.dpdns.org
# Browser -> API (sent to the page as <meta name="api-base">, also whitelisted in CSP)
API_BASE_URL=https://hatilapi.anshintech.dpdns.org/api/v1
PORT=4000
NODE_ENV=production
