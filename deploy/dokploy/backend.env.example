# Dokploy -> backend app -> Environment. Names match backend/app/core/config.py (pydantic, case-insensitive).
ENVIRONMENT=production
# Sync SQLAlchemy + psycopg 3 (asyncpg is NOT installed). URL-encode special chars in the password.
DATABASE_URL=postgresql+psycopg://postgres:__DB_PASSWORD__@164.68.106.67:5432/hatil
PUBLIC_BASE_URL=https://hatil.anshintech.dpdns.org
CORS_ORIGINS=https://hatil.anshintech.dpdns.org
# REQUIRED: replace every __placeholder__ below; startup refuses them in production.
# Generate with: openssl rand -hex 64
JWT_SECRET=__openssl_rand_hex_64__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
SUPER_ADMIN_EMAIL=__admin_email__
SUPER_ADMIN_PASSWORD=__strong_password__
UPLOAD_DIR=/app/uploads
RATE_LIMIT_ENABLED=true
SEED_DEMO=false
# Container port; must match the Dokploy domain port
PORT=4000
# Catalogue import on deploy (scripts/deploy_import.sh). `auto` = on the first deploy it backs the DB up,
# imports everything, verifies and writes /app/data/import.done; later deploys skip (done marker) or resume.
# After the first successful run (check /api/v1/admin/import/status), set CATALOG_IMPORT=off.
CATALOG_IMPORT=auto
CATALOG_IMPORT_FORCE=no
SCRAPER_RPS=1
SCRAPER_MAX_IMAGES=30
