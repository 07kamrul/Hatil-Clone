# --- Core ---
ENVIRONMENT=development
HTTP_PORT=80
PUBLIC_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:4200

# --- Database (docker-compose builds DATABASE_URL from these) ---
POSTGRES_USER=furniture
POSTGRES_PASSWORD=change-me
POSTGRES_DB=furniture
# For running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://furniture:change-me@localhost:5432/furniture

# --- Auth (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- Media ---
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/uploads
MAX_UPLOAD_MB=10
# S3 (when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=
S3_PUBLIC_URL=

# --- Rate limiting ---
RATE_LIMIT_PUBLIC_POST=5/minute
RATE_LIMIT_LOGIN=10/minute

# --- Branding: "neutral" replaces source brand terms in imported text with the site name ---
BRAND_MODE=neutral
BRAND_SOURCE_TERMS=HATIL,Hatil,hatil
DEFAULT_SITE_NAME=Sahat Al Ramlah Furniture

# --- Optional admin email notifications for contact messages ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
ADMIN_NOTIFY_EMAIL=
